{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PredictedFrame",
  "type": "object",
  "properties": {
    "control_epoch": {
      "$ref": "#/$defs/ControlEpoch"
    },
    "controlled_entity_id": {
      "$ref": "#/$defs/EntityId"
    },
    "motor": {
      "$ref": "#/$defs/CharacterMotor"
    },
    "tick": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "vehicle": {
      "anyOf": [
        {
          "$ref": "#/$defs/VehiclePrediction"
        },
        {
          "type": "null"
        }
      ]
    },
    "version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "version",
    "tick",
    "control_epoch",
    "controlled_entity_id",
    "motor"
  ],
  "$defs": {
    "CharacterMotor": {
      "type": "object",
      "properties": {
        "grounded": {
          "type": "boolean"
        },
        "jump_cooldown_ticks": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "position": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Scalar"
          },
          "maxItems": 3,
          "minItems": 3
        },
        "velocity": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Scalar"
          },
          "maxItems": 3,
          "minItems": 3
        },
        "yaw": {
          "$ref": "#/$defs/Yaw"
        }
      },
      "additionalProperties": false,
      "required": [
        "position",
        "velocity",
        "yaw",
        "grounded",
        "jump_cooldown_ticks"
      ]
    },
    "ControlEpoch": {
      "type": "integer",
      "maximum": 4294967295,
      "minimum": 1
    },
    "EntityId": {
      "type": "integer",
      "maximum": 4294967295,
      "minimum": 1
    },
    "Scalar": {
      "type": "number",
      "maximum": 3.4028234663852886e+38,
      "minimum": -3.4028234663852886e+38
    },
    "Steering": {
      "type": "number",
      "maximum": 0.550000011920929,
      "minimum": -0.550000011920929
    },
    "VehicleMotor": {
      "type": "object",
      "properties": {
        "position": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Scalar"
          },
          "maxItems": 3,
          "minItems": 3
        },
        "speed": {
          "$ref": "#/$defs/Scalar"
        },
        "steering": {
          "$ref": "#/$defs/Steering"
        },
        "velocity": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Scalar"
          },
          "maxItems": 3,
          "minItems": 3
        },
        "yaw": {
          "$ref": "#/$defs/Yaw"
        }
      },
      "additionalProperties": false,
      "required": [
        "position",
        "yaw",
        "speed",
        "steering",
        "velocity"
      ]
    },
    "VehiclePrediction": {
      "type": "object",
      "properties": {
        "motor": {
          "$ref": "#/$defs/VehicleMotor"
        },
        "template": {
          "$ref": "#/$defs/VehicleTemplate"
        }
      },
      "additionalProperties": false,
      "required": [
        "motor",
        "template"
      ]
    },
    "VehicleTemplate": {
      "type": "object",
      "properties": {
        "acceleration": {
          "type": "number",
          "format": "double"
        },
        "brake": {
          "type": "number",
          "format": "double"
        },
        "dimensions": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "maxItems": 3,
          "minItems": 3
        },
        "exit_offsets": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number",
              "format": "double"
            },
            "maxItems": 3,
            "minItems": 3
          }
        },
        "health": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "id": {
          "type": "string"
        },
        "reverse_speed": {
          "type": "number",
          "format": "double"
        },
        "seat_offset": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "maxItems": 3,
          "minItems": 3
        },
        "top_speed": {
          "type": "number",
          "format": "double"
        },
        "visual_asset_id": {
          "type": "string"
        },
        "wheelbase": {
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "dimensions",
        "top_speed",
        "reverse_speed",
        "acceleration",
        "brake",
        "wheelbase",
        "health",
        "visual_asset_id",
        "seat_offset",
        "exit_offsets"
      ]
    },
    "Yaw": {
      "type": "number",
      "maximum": 3.1415927410125732,
      "minimum": -3.1415927410125732
    }
  }
}