{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StaticRayQuery",
  "type": "object",
  "properties": {
    "direction": {
      "type": "array",
      "items": {
        "type": "number",
        "format": "float"
      },
      "maxItems": 3,
      "minItems": 3
    },
    "max_distance": {
      "type": "number",
      "format": "float"
    },
    "origin": {
      "type": "array",
      "items": {
        "type": "number",
        "format": "float"
      },
      "maxItems": 3,
      "minItems": 3
    },
    "version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "version",
    "origin",
    "direction",
    "max_distance"
  ]
}