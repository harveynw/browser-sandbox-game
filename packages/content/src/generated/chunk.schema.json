{
  "$defs": {
    "ArchitectureRecipe": {
      "additionalProperties": false,
      "properties": {
        "depth": {
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "floor_height": {
          "format": "double",
          "type": "number"
        },
        "floors": {
          "items": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "style": {
          "$ref": "#/$defs/ArchitectureStyle"
        },
        "width": {
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        }
      },
      "required": [
        "depth",
        "floor_height",
        "floors",
        "style",
        "width"
      ],
      "type": "object"
    },
    "ArchitectureStyle": {
      "enum": [
        "quay",
        "industrial",
        "modern",
        "residential",
        "civic",
        "market",
        "dockside"
      ],
      "type": "string"
    },
    "Bounds": {
      "additionalProperties": false,
      "properties": {
        "max": {
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        "min": {
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        }
      },
      "required": [
        "max",
        "min"
      ],
      "type": "object"
    },
    "BuildingIdentity": {
      "additionalProperties": false,
      "properties": {
        "architecture": {
          "$ref": "#/$defs/ArchitectureRecipe"
        },
        "neighbours": {
          "items": {
            "$ref": "#/$defs/Bounds"
          },
          "type": "array"
        },
        "purpose": {
          "type": "string"
        }
      },
      "required": [
        "architecture",
        "neighbours",
        "purpose"
      ],
      "type": "object"
    },
    "Primitive": {
      "additionalProperties": false,
      "properties": {
        "building": {
          "anyOf": [
            {
              "$ref": "#/$defs/BuildingIdentity"
            },
            {
              "type": "null"
            }
          ]
        },
        "center": {
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        "collider_id": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "color": {
          "type": "string"
        },
        "half_extents": {
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        "id": {
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/VisualRole"
        }
      },
      "required": [
        "center",
        "collider_id",
        "color",
        "half_extents",
        "id",
        "role"
      ],
      "type": "object"
    },
    "VisualRole": {
      "enum": [
        "vegetation",
        "ground",
        "road",
        "sidewalk",
        "marking",
        "building",
        "boundary",
        "landmark",
        "vehicle"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string"
    },
    "primitives": {
      "items": {
        "$ref": "#/$defs/Primitive"
      },
      "type": "array"
    },
    "schema_version": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "id",
    "primitives",
    "schema_version"
  ],
  "title": "VisualChunk",
  "type": "object"
}