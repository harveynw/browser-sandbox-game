  classDef sim fill:#DFF1E4,stroke:#BDC5CE,color:#202B38
  classDef gfx fill:#FBE5D2,stroke:#BDC5CE,color:#202B38
  classDef content fill:#FFF1BC,stroke:#BDC5CE,color:#202B38
