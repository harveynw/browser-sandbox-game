%% Frontend module system — current implementation through T18.
%% Update with module, ownership, transport or data-flow changes.
%% Purple: orchestration; blue: networking; green: simulation;
%% orange: graphics; yellow: content; grey: diagnostics/external.
flowchart TD
  subgraph group_0["apps/client/src/ — application"]
    main["main.ts<br/>Page routing"]:::app
    game["game/<br/>GameApp · frame loop · presentation orchestration<br/>Entry / exit and terminal prompts<br/>Job choices / checkpoints / repair payment feedback<br/>Private heat / pursuit and arrest feedback"]:::app
    diagnostics["game/diagnostics.ts<br/>Compact telemetry · 12-second graphs<br/>Expandable remote entity table"]:::app
    input["input/<br/>Walking / driving controls<br/>Interaction / terminal edges and held handbrake<br/>Aim / fire / reload with focus cleanup"]:::app
    settings["game/settings.ts · ui/settings-panel.ts<br/>Validated local preferences / names / key remaps"]:::app
    hud["ui/hud.ts · ui/city-map.ts<br/>10 Hz objective / vitals / tutorial<br/>North-up minimap · keyboard / pan / zoom map"]:::app
    audio["audio/sound.ts<br/>Gesture-gated WebAudio · 32-voice pool<br/>Spatial cues / engine / siren · pause / mute"]:::gfx
    tools["Diagnostic routes<br/>content/inspector.ts · simulation/page.ts<br/>app.ts"]:::other
  end
  subgraph group_1["apps/client/src/ — networking"]
    session["net/session.ts<br/>Bounded pending-profile HTTP admission<br/>Session lifecycle and state coordination"]:::net
    transport["net/transport.ts<br/>WebSocket + WebRTC"]:::net
    clock["net/clock.ts<br/>Server time and input lead"]:::net
    replica["world/replica.ts<br/>Player / NPC state and interpolation"]:::net
  end
  subgraph group_2["apps/client/src/ — simulation"]
    prediction["simulation/prediction.ts<br/>Local prediction and reconciliation<br/>Freeze disabled character controls"]:::sim
    bridge["simulation/bridge.ts<br/>Character / vehicle WASM adapter<br/>Car proxies and collision queries"]:::sim
  end
  subgraph group_3["apps/client/src/ — graphics"]
    renderer["render/renderer.ts<br/>Three.js scene, players, pedestrians and cars<br/>Instanced streamed chunks / fallback<br/>Job / repair signs and markers<br/>Private objective target · courier-only route<br/>Pooled shot / impact / dust effects and pistol<br/>Police car beacons"]:::gfx
    actors["render/character.ts · render/facades.ts<br/>In-place rig clips · four palettes · dynamic instancing<br/>Eight facade patterns · cosmetic wheels / lean"]:::gfx
    camera["render/camera.ts<br/>Walking / driving camera<br/>Obstruction checks · eased FOV / reduced motion"]:::gfx
  end
  subgraph group_4["Shared frontend packages"]
    content["packages/content/<br/>Full collision / config preload<br/>Hashed visual ChunkStream · 192 / 256 m"]:::content
    protocol["packages/protocol/<br/>Message encoding and validation"]:::net
    wasm["packages/sim-wasm/<br/>Shared Rust simulation in WASM"]:::sim
  end
    backend["Backend<br/>HTTP :3001 · WS / WebRTC :3000"]:::other

  main -->|"game page"| game
  main -->|"diagnostic pages"| tools
  settings -->|"persisted bindings / presentation options"| game
  settings -->|"bindings"| input
  game -->|"read-only status / public nearby poses"| hud
  game -->|"gesture / confirmed events / listener"| audio
  renderer -->|"pose and batch geometry"| actors
  input -->|"controls"| game
  game -->|"client frame / network / render samples"| diagnostics
  game -->|"advance frame"| session
  session <-->|"game messages"| transport
  transport <-->|"WS reliable / RTC unreliable"| backend
  session <-->|"HTTP admission"| backend
  session -->|"time estimate"| clock
  session -->|"codec"| protocol
  session -->|"inputs / owner corrections"| prediction
  prediction -->|"simulate / replay"| bridge
  bridge -->|"shared motor"| wasm
  session -->|"baselines / remote snapshots"| replica
  replica -.->|"sampled vehicle proxies for replay"| bridge
  session -->|"load assets"| content
  content -.->|"verified physics + initial assets"| game
  renderer <-->|"bounded visual loading / disposal"| content
  session -.->|"private mission / repair / police status + local / remote poses"| game
  game -->|"map and actor poses"| renderer
  game -->|"pose and look input"| camera
  camera -.->|"spherecast"| bridge
  camera -->|"camera transform"| renderer
  tools -.->|"session diagnostic"| session
  tools -.->|"map inspector"| content
  tools -.->|"simulation trace"| bridge

