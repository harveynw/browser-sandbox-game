%% Backend module system — current implementation through T21 local launch (G4 deferred by user).
%% Update with module, ownership, transport or data-flow changes.
%% Purple: orchestration; blue: networking; green: simulation;
%% orange: graphics; yellow: content; grey: diagnostics/external.
flowchart TD
  subgraph group_0["crates/server/src/ — startup and world"]
    launcher["tools/local.mjs<br/>Tool checks / builds / owned process groups<br/>Deadline / sibling cleanup / shutdown"]:::app
    probe["examples/local_probe.rs<br/>Normal guest admission / full baseline<br/>Real nonce-matched WS + RTC startup receipts"]:::other
    main["main.rs<br/>Startup and main loop"]:::app
    config["config.rs · config/dev.toml<br/>SQLite default / explicit memory mode"]:::app
    persistence["persistence.rs · SQLite worker thread<br/>Migrations / WAL / atomic economic ledger<br/>Repair acknowledgements and restart refunds"]:::other
    database["var/profiles.sqlite<br/>Profiles · economic events · unresolved repairs"]:::other
    performance["performance.rs<br/>Bounded world / complete-tick histograms<br/>Per-peer encoded bytes and queue snapshots"]:::other
    scheduler["scheduler.rs<br/>Fixed-step scheduling · 30 Hz"]:::app
    loader["content_loader.rs<br/>Select city.json · verify full world<br/>Preload all static collision"]:::content
    world["world.rs<br/>Authoritative sessions, players and movement"]:::sim
    police["police.rs<br/>Authoritative crime witnesses and private heat<br/>Fair capped patrol / pursuit · search / arrest"]:::sim
    combat["combat.rs<br/>Server pistol and hit queries<br/>Damage, cooldowns and safe respawns"]:::sim
    jobs["jobs.rs<br/>Mission acceptance / reward lifecycle<br/>Eight recovery reservations and safe garage exits"]:::sim
    repairs["repairs.rs<br/>Observed repair dwell / identity validation<br/>Queued debit, application and compensation"]:::sim
    missions["missions.rs<br/>Courier / recovery dwell and swept trial gates"]:::sim
    population["population.rs<br/>1 Hz director · 5 Hz NPC decisions<br/>Pool tags, lane paths and intersection reservations"]:::sim
    vehicles["vehicles.rs<br/>Car state, seat anchors and safe exits"]:::sim
  end
  subgraph group_1["crates/server/src/ — networking and admission"]
    control["control.rs · HTTP thread<br/>Sessions, tickets, health and cached /api/metrics"]:::net
    admission["admission.rs · shared state<br/>Guest profiles, one-use tickets<br/>Committed profile cache · bounded worker operations<br/>Memory adapter for tests"]:::net
    transport["transport.rs · network pump thread<br/>Bounded queues, codecs and channel routing"]:::net
    replication["replication.rs<br/>Visibility · snapshot packing<br/>Coalescing · rate budgets"]:::net
  end
  subgraph group_2["Shared Rust crates"]
    sim["crates/sim-core/<br/>Character / vehicle motors<br/>Static collision and car proxies"]:::sim
    content["crates/content/<br/>Content types and validation"]:::content
    protocol["crates/protocol/<br/>Serde DTOs · direct MessagePack codec<br/>Scalar / input-batch limits"]:::net
  end
    browser["Browser frontend"]:::other
    assets["Baked content package<br/>Six districts · collision / configuration<br/>Visual streaming belongs to browser"]:::content
    net["net-crate<br/>WebSocket + WebRTC server"]:::other

  launcher -->|"spawn release server"| main
  launcher -->|"run after frontend proxy is live"| probe
  probe <-->|"normal WS / RTC signalling and messages"| net
  probe <-->|"HTTP through Vite proxy / receipt report"| control
  main -->|"validate local configuration"| config
