  main -->|"load at startup"| loader
  assets -->|"baked package"| loader
  loader -->|"validation"| content
  loader -->|"loaded world"| world
  main <-->|"elapsed time"| scheduler
  main -->|"30 Hz steps"| world
  world -->|"per-system timing"| performance
  main -->|"complete tick timing"| performance
  transport -->|"queue depths / close reasons"| control
  performance -->|"read-only cached metrics"| control
  main -->|"start / publish health"| control
