%% Current backend architecture after the native ECS migration.
flowchart TD
  Main["main.rs<br/>30 Hz cadence, network polling, overload limits"]
  Startup["ecs/bootstrap.rs · PreparedWorld<br/>Validate content and spawns<br/>Indexed parked actors and initial patrols"]
  Driver["tick.rs · TickDriver<br/>One authoritative Bevy world<br/>Small driver: step and service access"]
  Main --> Startup --> Driver
  Driver --> ECS["ecs/<br/>Phase order, schedules, checkpoints<br/>Resources, message registration and setup"]
  Content["content_loader.rs<br/>Immutable verified content/configuration"] --> Startup
  Browser["Browser clients"] <-->|WS / RTC| Network["transport.rs<br/>Bounded transport queues and codecs"]
  Main -->|poll / flush| Network
  Network --> Ingress["sessions/ingress.rs<br/>Scope, budgets, packet ordering<br/>Admission and baseline messages"]
  Ingress --> Driver
  ECS --> Gameplay["Native query systems<br/>Planning → movement → combat → police<br/>Failed peers → repairs → missions"]
  Gameplay <--> Actors["components.rs · data only<br/>Player / vehicle / pedestrian / officer<br/>AI controllers, wanted, missions, lifecycle"]
  Gameplay <--> Messages["Typed ECS messages<br/>Actions, impacts, crime, lifecycle<br/>Control transitions and rewards"]
  Gameplay <--> Resources["Shared coordination resources<br/>Navigation, RNG, reservations<br/>Cooldowns, metrics and session protocol state"]
  Gameplay --> Collision["sim-core<br/>Shared motors and collision queries"]
  ECS --> Publish["replication/publication.rs + native.rs<br/>Map → visibility → owners → snapshots → status<br/>Ordered commit and failure cleanup"]
  Actors --> Publish
  Publish --> Egress["replication/egress.rs<br/>Bounded flush and message-driven failure cleanup"]
  Egress --> Network
  Egress --> Messages
  Profiles["admission.rs<br/>Profile cache, ticket service, operation receipts"] <-->|bounded work / committed results| Storage["persistence.rs<br/>SQLite worker and durable economic ledger"]
  Ingress --> Profiles
  Gameplay --> Profiles
  HTTP["control.rs · HTTP thread<br/>Guest/session APIs, health and cached metrics"] <--> Profiles
  Browser <-->|HTTP| HTTP
  Diagnostics["diagnostics.rs<br/>Read-only ECS snapshot<br/>Detailed metrics once per second"] --> HTTP
  Actors --> Diagnostics
  Resources --> Diagnostics
  Main --> Diagnostics
  Main --> Shutdown["shutdown.rs<br/>Native disconnect cleanup<br/>Bounded repair/persistence drain"]
  Shutdown --> Messages
  Shutdown --> Profiles
  classDef sim fill:#d5f5df,stroke:#278344
  classDef io fill:#dcebf8,stroke:#5b83a5
  class Startup,Driver,Gameplay,Actors,Messages,Resources,Collision,Publish,Diagnostics,Shutdown sim
  class Network,Ingress,Egress,Profiles,Storage,HTTP io
